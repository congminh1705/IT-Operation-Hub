// Source: requirements/conceptual-data-model.md and BR-01..22.
// Nullable/index/FK proposals require D-40 review; omitted fields are not optional business rules.
Project it_operations_hub {
  database_type: 'PostgreSQL'
  Note: 'Documentation only. No database, migration or approved physical schema.'
}

